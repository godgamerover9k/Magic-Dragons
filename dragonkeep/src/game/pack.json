  "iv": {
    "name": "Individual Value",
    "description": "Rolled 0-31 when the dragon hatches. Fixed for life, never inherited.",
    "curveExponent": 3,
    "disadvantage": true,
    "productionMagnitude": 0.6,
    "growthMagnitude": 0
  },
  "breedingRules": [
    {
      "id": "rule-example-species",
      "label": "Fire and Water",
      "a": {
        "kind": "species",
        "speciesId": "fire-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "water-dragon"
      },
      "outcomes": [
        {
          "speciesId": "air-dragon",
          "weight": 30
        }
      ],
      "enabled": true,
      "notes": "Two exact dragons. The parents stay in the pool, so this is a strong chance, not a certainty."
    },
    {
      "id": "rule-lava",
      "label": "Earth and Fire",
      "a": {
        "kind": "species",
        "speciesId": "earth-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "fire-dragon"
      },
      "outcomes": [
        {
          "speciesId": "lava-dragon",
          "weight": 4
        }
      ],
      "enabled": true,
      "notes": "Deliberately slim \u2014 the parents sit at 50 each, so this lands near 4%."
    },
    {
      "id": "rule-plant",
      "label": "Earth and Water",
      "a": {
        "kind": "species",
        "speciesId": "earth-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "water-dragon"
      },
      "outcomes": [
        {
          "speciesId": "plant-dragon",
          "weight": 30
        }
      ],
      "enabled": true,
      "notes": "A dependable combo, on a par with Fire and Water making Air."
    },
    {
      "id": "rule-life",
      "label": "Two Plants",
      "a": {
        "kind": "species",
        "speciesId": "plant-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "plant-dragon"
      },
      "outcomes": [
        {
          "speciesId": "life-dragon",
          "weight": 12
        }
      ],
      "enabled": true,
      "notes": "Both parents are the same, so the pool collapses to Plant at 100 plus this."
    },
    {
      "id": "rule-inferno",
      "label": "Fire and Plant",
      "a": {
        "kind": "species",
        "speciesId": "fire-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "plant-dragon"
      },
      "outcomes": [
        {
          "speciesId": "inferno-dragon",
          "weight": 20
        }
      ],
      "enabled": true,
      "notes": "The ordinary route to an Inferno."
    },
    {
      "id": "rule-inferno-self",
      "label": "Two Fires",
      "a": {
        "kind": "species",
        "speciesId": "fire-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "fire-dragon"
      },
      "outcomes": [
        {
          "speciesId": "inferno-dragon",
          "weight": 1
        }
      ],
      "enabled": true,
      "notes": "A far longer shot than Fire and Plant \u2014 roughly one breed in a hundred."
    },
    {
      "id": "rule-perfection",
      "label": "Two flawless parents",
      "a": {
        "kind": "any"
      },
      "b": {
        "kind": "any"
      },
      "outcomes": [
        {
          "speciesId": "perfection-dragon",
          "weight": 100
        }
      ],
      "enabled": true,
      "notes": "Both parents at a perfect 31. Reaching that at all is the hard part, so the odds here are generous.",
      "conditions": {
        "minIv": 31
      }
    },
    {
      "id": "rule-corruption",
      "label": "Two hollow parents",
      "a": {
        "kind": "any"
      },
      "b": {
        "kind": "any"
      },
      "outcomes": [
        {
          "speciesId": "corruption-dragon",
          "weight": 25
        }
      ],
      "conditions": {
        "maxIv": 0
      },
      "enabled": true,
      "notes": "Both parents at a flat 0. Far easier to arrange than Perfection, so the weight is much lower."
    },
    {
      "id": "rule-metal",
      "label": "Elemental and Earth",
      "a": {
        "kind": "species",
        "speciesId": "elemental-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "earth-dragon"
      },
      "outcomes": [
        {
          "speciesId": "metal-dragon",
          "weight": 25
        }
      ],
      "enabled": true,
      "notes": "Needs an Elemental Dragon first, so it sits a step behind the four base elements."
    },
    {
      "id": "rule-monster",
      "label": "Corruption and Life",
      "a": {
        "kind": "species",
        "speciesId": "corruption-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "life-dragon"
      },
      "outcomes": [
        {
          "speciesId": "monster-dragon",
          "weight": 25
        }
      ],
      "enabled": true,
      "notes": "Both parents are Transcendent, so this sits at the deep end of the tree."
    },
    {
      "id": "rule-perfection-half",
      "label": "One flawless parent",
      "a": {
        "kind": "any"
      },
      "b": {
        "kind": "any"
      },
      "outcomes": [
        {
          "speciesId": "perfection-dragon",
          "weight": 2
        }
      ],
      "conditions": {
        "minIvEither": 31
      },
      "enabled": true,
      "notes": "A long shot on a single perfect parent \u2014 around 2%, against 43% for two."
    },
    {
      "id": "rule-corruption-half",
      "label": "One hollow parent",
      "a": {
        "kind": "any"
      },
      "b": {
        "kind": "any"
      },
      "outcomes": [
        {
          "speciesId": "corruption-dragon",
          "weight": 2
        }
      ],
      "conditions": {
        "maxIvEither": 0
      },
      "enabled": true,
      "notes": "A long shot on a single hollow parent \u2014 around 2%, against 16% for two."
    },
    {
      "id": "rule-ether",
      "label": "Elemental and Perfection",
      "a": {
        "kind": "species",
        "speciesId": "elemental-dragon"
      },
      "b": {
        "kind": "species",
        "speciesId": "perfection-dragon"
      },
      "outcomes": [
        {
          "speciesId": "ether-dragon",
          "weight": 25
        }
      ],
      "enabled": true,
      "notes": "Needs a Perfection Dragon, so it sits at the very back of the tree."
    },
    {
      "id": "rule-elemental-cross",
      "label": "Two different elements",
      "a": {
        "kind": "taxon",
        "taxonId": "base-elements",
        "includeDescendants": true
      },
      "b": {
        "kind": "taxon",
        "taxonId": "base-elements",
        "includeDescendants": true
      },
      "outcomes": [
        {
          "speciesId": "elemental-dragon",
          "weight": 3
        }
      ],
      "conditions": {
        "differentBranchUnder": "base-elements"
      },
      "enabled": true,
      "notes": "Both parents must be filed under Base Elements, in different elements. Two dragons from the same element - Fire and Inferno, say - are turned away."
    }
  ],
